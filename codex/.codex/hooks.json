{
  "description": "Personal attention indicators for Codex sessions.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.codex/codex-tmux-mark.sh start",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.codex/codex-tmux-mark.sh end",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
