<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scarlett-mic.sh replaces __HOME__ and writes the result to
     ~/Library/LaunchAgents, because launchd expands neither ~ nor $HOME. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.local.scarlett-mic</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.local/bin/scarlett-mic</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/scarlett-mic.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/scarlett-mic.log</string>
</dict>
</plist>
